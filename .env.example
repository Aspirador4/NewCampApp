# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Obtén estos valores desde tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave Service Role (privada, solo para Server Actions / API Routes administrativas)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# PWA & Web Push Notifications (Fase 6 - VAPID)
# ==============================================================================
# Genera tus claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:admin@clubdeportivo.com

# ==============================================================================
# App Settings
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
